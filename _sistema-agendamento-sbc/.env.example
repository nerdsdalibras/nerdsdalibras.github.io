# Copie para .env e preencha. NUNCA versione o arquivo .env.
DJANGO_SECRET_KEY=gere-com: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=sgi.exemplo.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://sgi.exemplo.invalid
HTTPS_ATIVO=true
ATRAS_DE_PROXY=true
URL_BASE=https://sgi.exemplo.invalid

DB_NAME=sgi
DB_USER=sgi_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

MEDIA_ROOT=/var/lib/sgi/media

# E-mail — conta remetente da Nerds da Libras (Gmail).
# EMAIL_HOST_PASSWORD = SENHA DE APP do Google (exige verificação em duas etapas na conta);
# nunca a senha normal da conta. Diagnóstico: python manage.py testar_email
# Mantenha EMAIL_ENVIO_HABILITADO=false até liberar o envio real aos fiscais.
EMAIL_ENVIO_HABILITADO=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=nerdsdalibras@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_REMETENTE=Nerds da Libras - SGI <nerdsdalibras@gmail.com>
EMAIL_RESPONDER_PARA=
# Em homologação, restrinja destinatários (ex.: exemplo.invalid). Vazio = sem filtro.
EMAIL_DOMINIOS_PERMITIDOS=

# Google Drive — cópia externa dos backups CIFRADOS na conta nerdsdalibras@gmail.com.
# Obtenha o refresh token com: python manage.py drive_autorizar (ver manual, seção 3.1).
GDRIVE_CONTA=nerdsdalibras@gmail.com
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_PASTA=SGI-SBC-backups
